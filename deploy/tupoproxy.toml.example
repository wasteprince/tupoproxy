[general]
use_middle_proxy = true
log_level = "normal"

[general.modes]
classic = false
secure = false
tls = true

[general.links]
show = "*"
public_host = "203.0.113.10"
public_port = 443

[server]
proxy_protocol = true
proxy_protocol_trusted_cidrs = ["127.0.0.1/32", "::1/128"]

[[server.listeners]]
ip = "127.0.0.1"
port = 18443
announce = "203.0.113.10"

[server.api]
enabled = true
listen = "127.0.0.1:9091"
whitelist = ["127.0.0.1/32", "::1/128"]

[censorship]
tls_domain = "proxy.example.com"
tls_fingerprints = { "proxy.example.com" = "chrome" }

# The reverse proxy passes this SNI as raw TCP. Invalid credentials and probes
# are closed without a certificate or an HTTPS fallback.
mask = false
mask_dynamic = false
mask_port = 443
unknown_sni_action = "drop"

tls_emulation = true
tls_front_dir = "/var/lib/tupoproxy/tlsfront-hmac-only"
alpn_enforce = true
tls_new_session_tickets = 0

[access.users]
# Replace with: openssl rand -hex 16
hello = "00000000000000000000000000000000"

# Optional: route the server-to-Telegram leg through a local SOCKS listener.
# This changes only the outbound leg, not the Telegram client transport.
# [[upstreams]]
# type = "socks5"
# address = "127.0.0.1:1080"
